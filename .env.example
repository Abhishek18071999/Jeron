# Copy this file to .env and change the values. Never commit .env.
# Keys for the broker and the LLM are added in later milestones.

POSTGRES_USER=jeron
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jeron

# Risk manager (spec section 5). A paper account keeps the values it opened with.
JERON_CAPITAL=1000000
# Percent of equity at risk per trade, 0.5 to 2.
JERON_RISK_PCT=1
JERON_MAX_POSITIONS_SWING=5
JERON_MAX_POSITIONS_POSITIONAL=8
JERON_SECTOR_CAP_PCT=30

# Alerts (M5). Telegram: create a bot with @BotFather, paste its token here, send the
# bot any message, then run `python -m app.cli telegram --setup` to get your chat id.
JERON_TELEGRAM_BOT_TOKEN=
JERON_TELEGRAM_CHAT_ID=
# Also send research-only signals one by one (they are always in the daily summary).
JERON_ALERT_RESEARCH_SIGNALS=false
# Email backup (optional), used when Telegram is not set up or fails. For Gmail use an
# app password: smtp.gmail.com, port 587.
JERON_SMTP_HOST=
JERON_SMTP_PORT=587
JERON_SMTP_USER=
JERON_SMTP_PASSWORD=
JERON_ALERT_EMAIL_FROM=
JERON_ALERT_EMAIL_TO=
# News labels (M6). Keys go only here, never in chat or in the repo. Without a key the
# news brain is off. JERON_NEWS_PROVIDER is claude, deepseek or ollama (Ollama Cloud).
JERON_NEWS_PROVIDER=claude
# Claude: create a key at console.anthropic.com (paid per use; API credit is separate
# from a Claude.ai plan). Model: claude-opus-5-5, claude-sonnet-5-5 or claude-haiku-4-5.
JERON_ANTHROPIC_API_KEY=
JERON_NEWS_MODEL=claude-opus-5-5
# DeepSeek: create a key at platform.deepseek.com.
JERON_DEEPSEEK_API_KEY=
JERON_DEEPSEEK_MODEL=deepseek-chat
# Ollama Cloud: create a key at ollama.com/settings/keys. Cloud models are listed at
# ollama.com/search?c=cloud.
JERON_OLLAMA_API_KEY=
JERON_OLLAMA_MODEL=gemma4:31b
# Where the web app is, for links in alerts (your laptop's address to open them on the phone).
JERON_WEB_URL=http://localhost:3000

# Scheduler (M7): when the jobs run, HH:MM IST on trading days. The daily job, then the
# weekly summary after the last session of the week; the pre-open check of open positions.
JERON_SCHEDULE_DAILY=19:00
JERON_SCHEDULE_PREOPEN=08:30
