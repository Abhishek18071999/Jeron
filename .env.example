# Copy this file to .env and change the values. Never commit .env.
# Keys for the broker, Telegram and the LLM are added in later milestones.

POSTGRES_USER=jeron
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jeron

# Risk manager (spec section 5). A paper account keeps the values it opened with.
JERON_CAPITAL=1000000
# Percent of equity at risk per trade, 0.5 to 2.
JERON_RISK_PCT=1
JERON_MAX_POSITIONS_SWING=5
JERON_MAX_POSITIONS_POSITIONAL=8
JERON_SECTOR_CAP_PCT=30
